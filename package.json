{
  "name": "ttydiy-theme",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "rm -rf packages/*/dist && tsc -p packages/theme && tsc -p packages/react-theme",
    "test": "npm run build && npm run test:types && npm run test:lib && npm run test:build",
    "test:types": "tsc -p tsconfig.json",
    "test:lib": "node --import ./test-setup.ts --test 'packages/*/tests/*.test.ts'",
    "test:build": "publint --strict packages/theme && publint --strict packages/react-theme"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true
  }
}
